# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore - it must never be committed.

# Supabase project (Project Settings -> API Keys / Data API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<anon / publishable key - NOT the service_role / secret key>

# Postgres via the Session pooler (Connect -> Session pooler)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require

# Read-only role that runs quiz takers' SQL
DB_READER_USER=quiz_reader.<your-project-ref>
DB_READER_PASSWORD=<password you set for quiz_reader>

# App role that saves answers and writes the audit log
DB_APP_USER=quiz_app.<your-project-ref>
DB_APP_PASSWORD=<password you set for quiz_app>
